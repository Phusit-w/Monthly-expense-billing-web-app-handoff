# Copy this file to `.env` next to docker-compose.yml and set real values
# before running `docker compose up`. This .env is only for docker-compose —
# the app container gets DATABASE_URL from docker-compose.yml, not from here.
POSTGRES_PASSWORD=change-me

# Shared HTTP Basic Auth credentials (proxy.ts) — this app has no per-user
# login, so one username/password pair gates the whole site. Meant to be
# used behind the caddy service's HTTPS (see docker-compose.yml) — Basic
# Auth sends credentials as unencrypted base64, so without TLS in front of
# it, the password is exposed to anyone who can see the traffic.
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me

# How many days of automatic database backups to keep in ./backups (see
# backup.sh) before older ones are deleted. Optional — defaults to 30 if
# not set.
# BACKUP_RETENTION_DAYS=30
