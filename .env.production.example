# Template for the PRODUCTION `.env` on the Windows server (native deploy).
# Do NOT reuse the dev `.env` (that one points at the ephemeral `npx prisma dev`
# database used only on the developer's machine).
#
# Copy this to `.env` on the server after installing PostgreSQL natively and
# creating the `expense_billing` database + user, then run:
#   npx prisma migrate deploy
#
# The Windows Service itself (install-service.ps1) gets DATABASE_URL from its
# own environment block, not from this file — this .env is only needed on the
# server for running Prisma CLI commands by hand (migrate deploy, studio, etc).

DATABASE_URL="postgresql://expense_billing:REPLACE_WITH_REAL_PASSWORD@localhost:5432/expense_billing?sslmode=disable"

# Signs per-user login session cookies (proxy.ts, lib/auth.ts) — every
# person gets their own username/password instead of one shared pair (see
# docs/DEPLOY-WINDOWS.md's "การเพิ่มผู้ใช้" section for how to create
# accounts). This just needs to be a long random value unique to this
# deployment; changing it logs everyone out. install-service.ps1 also
# accepts -SessionSecret directly instead of via this file. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_REAL_SESSION_SECRET

# Private SOC storage and provider setting used by the separate worker.
SOC_STORAGE_ROOT=C:\expense-billing-data\soc
SOC_AI_PROVIDER=disabled
